GEMINI_API_KEY=
CV_SERVICE_TOKEN=
PORT=8001

# Optional tuning (defaults shown). Comma-separated model chains, primary
# first: the next model is asked when the one before is slow or failing, and
# for serial/expiry labels the second model also reads the label
# independently — the two readings must agree.
# GEMINI_IMAGE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_VIDEO_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# SECOND_READ_GRACE_SECONDS=4.0
# DAILY_AI_CALL_LIMIT=2500
